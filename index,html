  <script>
    const screens = {
      phone: document.getElementById('screenPhone'),
      code: document.getElementById('screenCode'),
      chats: document.getElementById('screenChats'),
      settings: document.getElementById('screenSettings'),
      profile: document.getElementById('screenProfile'),
      editProfile: document.getElementById('screenEditProfile'),
      chat: document.getElementById('screenChat')
    };
    let current = 'phone';
    let history = ['phone'];

    function goTo(name, dir = 'forward') {
      if (name === current) return;
      const from = screens[current], to = screens[name];
      Object.values(screens).forEach(s => s.classList.remove('active','next','prev'));
      if (dir === 'forward') { from.classList.add('prev'); to.classList.add('active'); history.push(name); }
      else { from.classList.add('next'); to.classList.add('active'); history.pop(); }
      current = name;
    }
    function goBack() {
      if (history.length <= 1) return;
      goTo(history[history.length-2], 'back');
    }
    function openChat() { goTo('chat'); }
    function dismissBanner(isMe) {
      const b = document.getElementById('securityBanner');
      if (!b) return;
      b.style.transition = 'all 0.25s'; b.style.opacity = '0'; b.style.maxHeight = '0'; b.style.margin = '0'; b.style.padding = '0'; b.style.overflow = 'hidden';
      setTimeout(() => b.remove(), 280);
      if (!isMe) setTimeout(() => alert('Сессии на других устройствах будут завершены'), 300);
    }

    // ===== SAVE PROFILE (имя + юзернейм + номер) =====
    function saveProfile() {
      const name = document.getElementById('editName').value.trim() || 'mellstroy';
      const bio = document.getElementById('editBio').value.trim() || '';
      let phone = document.getElementById('editPhone').value.trim() || '+7 777 161 85 60';
      let username = document.getElementById('editUsername').value.trim().replace(/^@/, '') || 'brat077V';

      // Обновляем все места, где отображаются данные
      document.getElementById('settingsName').textContent = name;
      document.getElementById('settingsPhone').textContent = phone;
      document.getElementById('settingsUsername').textContent = '@' + username;

      document.getElementById('profileName').textContent = name;
      document.getElementById('profilePhone').textContent = phone;
      document.getElementById('profileUsername').textContent = '@' + username;
      document.getElementById('profileBio').textContent = bio;

      // Возвращаемся назад
      goBack();
    }

    // Username: только латиница, цифры и _
    document.getElementById('editUsername').addEventListener('input', function(e) {
      this.value = this.value.replace(/[^a-zA-Z0-9_]/g, '');
    });

    // Phone: лёгкая маска
    document.getElementById('editPhone').addEventListener('input', function(e) {
      // Разрешаем +, цифры и пробелы
      this.value = this.value.replace(/[^\d+\s]/g, '');
    });

    // Phone auth logic
    const phoneInput = document.getElementById('phoneInput');
    const continueBtn = document.getElementById('continueBtn');
    phoneInput.addEventListener('input', e => {
      let d = e.target.value.replace(/\D/g,'').slice(0,9);
      let f = '';
      if (d.length>0) f=d.slice(0,3);
      if (d.length>3) f+=' '+d.slice(3,6);
      if (d.length>6) f+=' '+d.slice(6,9);
      e.target.value = f;
      continueBtn.disabled = d.length !== 9;
    });
    continueBtn.addEventListener('click', () => {
      if (continueBtn.disabled) return;
      const d = phoneInput.value.replace(/\D/g,'');
      document.getElementById('displayNumber').textContent = `+888 ${d.slice(0,3)} ${d.slice(3,6)} ${d.slice(6,9)}`;
      startTimer(); goTo('code'); setTimeout(()=>document.querySelector('.code-digit').focus(),300);
    });

    // Code
    const codeDigits = document.querySelectorAll('.code-digit');
    const verifyBtn = document.getElementById('verifyBtn');
    let timeLeft = 60, timerInterval;
    function startTimer() {
      clearInterval(timerInterval); timeLeft=60;
      const btn = document.getElementById('resendBtn');
      btn.disabled=true; btn.innerHTML='Отправить код повторно через <span id="timer">60</span>';
      timerInterval = setInterval(()=>{
        timeLeft--; const t=document.getElementById('timer'); if(t) t.textContent=timeLeft;
        if(timeLeft<=0){ clearInterval(timerInterval); btn.disabled=false; btn.innerHTML='Отправить код повторно'; }
      },1000);
    }
    codeDigits.forEach((inp,i)=>{
      inp.addEventListener('input',e=>{
        e.target.value = e.target.value.replace(/\D/g,'').slice(0,1);
        if(e.target.value && i<5) codeDigits[i+1].focus();
        verifyBtn.disabled = Array.from(codeDigits).map(d=>d.value).join('').length!==6;
      });
      inp.addEventListener('keydown',e=>{
        if(e.key==='Backspace' && !e.target.value && i>0){ codeDigits[i-1].focus(); codeDigits[i-1].value=''; }
      });
    });
    verifyBtn.addEventListener('click',()=>{ if(!verifyBtn.disabled) goTo('chats'); });
  </script>
