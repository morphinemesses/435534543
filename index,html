<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Telegram — Settings & Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
      background: #000; overflow: hidden; margin: 0;
    }
    .screen {
      position: absolute; inset: 0; display: flex; flex-direction: column; background: #000;
      transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.28s ease;
      will-change: transform, opacity;
    }
    .screen.active { transform: translateX(0); opacity: 1; z-index: 10; pointer-events: auto; }
    .screen.next { transform: translateX(100%); opacity: 1; z-index: 5; pointer-events: none; }
    .screen.prev { transform: translateX(-28%); opacity: 0.35; z-index: 1; pointer-events: none; }

    .toggle-track { transition: background-color 0.2s ease; }
    .toggle-thumb { transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    input:checked + .toggle-track { background-color: #3b82f6; }
    input:checked + .toggle-track .toggle-thumb { transform: translateX(20px); }

    .code-digit {
      width: 42px; height: 52px; border-radius: 12px; background: #1c1c1e;
      border: 1.5px solid transparent; text-align: center; font-size: 24px; font-weight: 500;
      color: white; outline: none; transition: border-color 0.15s, background 0.15s;
    }
    .code-digit:focus { border-color: #3b82f6; }
    .code-digit.filled { background: #2c2c2e; }

    .btn-primary { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    .btn-primary:active:not(:disabled) { transform: scale(0.97); }

    .chat-item:active, .settings-row:active { background: #1c1c1e; }

    .bubble { max-width: 78%; border-radius: 18px; padding: 9px 13px; line-height: 1.35; }
    .bubble-in { background: #1c1c1e; border-bottom-left-radius: 4px; }

    .tab-bar {
      background: rgba(28, 28, 30, 0.92);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-top: 0.5px solid rgba(255,255,255,0.08);
    }
    .tab-item.active { color: #3b82f6; }

    .security-banner {
      background: linear-gradient(135deg, #1e3a5f 0%, #1a2a4a 100%);
      border: 1px solid rgba(59, 130, 246, 0.25);
    }

    .settings-section { background: #1c1c1e; border-radius: 14px; overflow: hidden; }
    .settings-row { display: flex; align-items: center; gap: 14px; padding: 11px 14px; }
    .settings-row + .settings-row { border-top: 0.5px solid rgba(255,255,255,0.06); }
    .settings-icon {
      width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    input.edit-field {
      width: 100%; background: transparent; outline: none; color: white; font-size: 17px;
    }
    input.edit-field::placeholder { color: #6b7280; }
  </style>
</head>
<body class="bg-black text-white h-screen w-screen overflow-hidden">

  <div class="relative w-full h-full max-w-[390px] mx-auto overflow-hidden">

    <!-- ===================== PHONE ===================== -->
    <div id="screenPhone" class="screen active">
      <div class="relative pt-14 pb-5 px-5 flex-shrink-0">
