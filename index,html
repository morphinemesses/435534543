            <div class="toggle-thumb absolute top-[3px] left-[3px] w-[25px] h-[25px] bg-white rounded-full shadow"></div>
          </div>
        </label>
      </div>
      <div class="flex-1"></div>
      <div class="px-5 pb-10">
        <button id="continueBtn" disabled class="btn-primary w-full h-[50px] rounded-xl text-[17px] font-semibold disabled:bg-neutral-800 disabled:text-neutral-600 bg-blue-500 text-white">Продолжить</button>
